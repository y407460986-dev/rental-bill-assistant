# Copy to .env; Prisma CLI and Next.js both load it. Never commit credentials.
# Supabase Connect > Transaction pooler (runtime). Copy the actual host/user.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Supabase Connect > Session pooler (migrations, IPv4 compatible).
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
DEEPSEEK_API_KEY=
# Image extraction uses DeepSeek's current vision model (deepseek-flash).
# Flash may rewrite printed rows; extracted amounts are checked against OCR
# and mismatches block automatic publication. Text search still uses
# DEEPSEEK_TEXT_MODEL.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=
APP_BASE_URL=http://localhost:3000

# Supabase Auth public project settings; never use the service role key as a public key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: Auth admin initialization and private storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bill-evidence
DEMO_ACCOUNT_PASSWORD=
PAYPAL_MERCHANT_ID=
