# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Configuration template contains no credentials
!.env.example
# Local task logs
.install.log
.runtime.log
.checks.log
.build-result

# Local conversation and workspace backups
/.backup/
/.workbuddy/
/.paypal-sandbox-accounts.json
/paypal-sandbox-accounts.json
**/paypal-sandbox-accounts.json
/.dsh-vision-router/

# Local design research and validation artifacts
/.design-references/
/.ui-checks/

/.rental-checks/

# Local secret backups (never publish)
/backups/
*.enc.json
